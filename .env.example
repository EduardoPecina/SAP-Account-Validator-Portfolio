# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to version control.

INPUT_CSV=C:\temp\validator_input.csv
OUTPUT_CSV=C:\temp\validator_output.csv
SAP_COMPANY_CODE=XXXX
TARGET_MOVEMENT_TYPE=XX

# Phrase(s) SAP shows when a filtered list has no matching rows, in
# your SAP GUI's logon language. Separate multiple phrases with "|" if
# your team runs SAP in more than one language, e.g.:
#   SAP_NO_DATA_MESSAGES=no data found|no contiene datos
SAP_NO_DATA_MESSAGES=no data found
